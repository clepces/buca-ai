{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Hybrid user identity and profile settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "profile": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "firstName": { "type": "string" },
            "lastName": { "type": "string" },
            "mail": { "type": "string" },
            "phone": { "type": "string" },
            "tax_id": { "type": "string" },
            "fiscal_address": { "type": "string" },
            "city_state": { "type": "string" },
            "platform_role": { "type": "string" },
            "active_mode": { "type": "string" }
          }
        },
        "worker_profile": {
          "type": "object",
          "properties": {
            "job_title": { "type": "string" },
            "department": { "type": "string" },
            "shift_preference": { "type": "string" },
            "bio": { "type": "string" },
            "availability_status": { "type": "string" },
            "reputation_score": { "type": "number" },
            "total_shifts_completed": { "type": "number" }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "two_factor_enabled": { "type": "boolean" },
            "recovery_email": { "type": "string" }
          }
        }
      }
    },
    "Business": {
      "title": "Business Unit",
      "description": "Multi-tenant business unit information.",
      "type": "object",
      "properties": {
        "owner_id": { "type": "string" },
        "name": { "type": "string" },
        "tax_id": { "type": "string" }
      }
    },
    "Notification": {
      "title": "System Notification",
      "description": "Real-time system alerts and broadcast messages.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "author_id": { "type": "string" },
        "read_by": { "type": "array", "items": { "type": "string" } },
        "target_tenant": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "System-wide broadcast and targeted notifications."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile collection."
    },
    "/businesses/{bizId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Business units collection."
    },
    "/finance_rates/{tenantId}": {
      "schema": {
        "type": "object",
        "properties": {
          "rate": { "type": "number" },
          "currency": { "type": "string" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "tenantId": { "type": "string" }
        }
      },
      "description": "Custom anchored exchange rates for the ERP."
    }
  }
}
