{
  "name": "buca-ai",
  "version": "1.1.23-alpha",
  "description": "B.U.C.A. AI (Business Under Control Access) - Modular Vanilla JS ERP Platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0 --port=3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint src",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier --write \"src/**/*.{js,scss,html,json}\"",
    "type-check": "tsc --project jsconfig.json --noEmit",
    "test": "node --experimental-websocket --test tests/supabase-storage.test.js tests/mfa-enrollment.test.js tests/database-security.test.js tests/offline-eventbus.test.js tests/finance-sync.test.js tests/forex-adapters.test.js"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@eslint/js": "^10.0.1",
    "@markuplint/html-parser": "^4.0.0",
    "@markuplint/html-spec": "^4.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "markuplint": "^3.8.0",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "autoprefixer": "^10.6.2",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "d3": "^7.9.0",
    "lucide": "^1.74.0",
    "zod": "^4.6.7"
  }
}
