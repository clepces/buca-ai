{
  "name": "buca-ai",
  "version": "1.0.0-alpha",
  "description": "B.U.C.A. AI (Business Under Control Access) - Modular Vanilla JS ERP Platform",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0 --port=3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint:js": "eslint src",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier --write \"src/**/*.{js,scss,html,json}\"",
    "type-check": "tsc --project jsconfig.json --noEmit",
    "test:rules": "npx firebase-tools emulators:exec --only firestore \"node --test tests/firestore-rules.test.js\"",
    "test": "npm run test:rules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@markuplint/html-parser": "^4.0.0",
    "@markuplint/html-spec": "^4.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "markuplint": "^4.0.0",
    "prettier": "^3.5.0",
    "sass-embedded": "^1.106.1",
    "stylelint": "^16.15.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "autoprefixer": "^10.6.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "d3": "^7.9.0",
    "firebase": "^11.0.2",
    "lucide": "^1.63.0",
    "zod": "^4.6.7"
  }
}
