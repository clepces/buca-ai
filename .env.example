# =========================================================================
# B.U.C.A. AI - Variables de Entorno de Ejemplo (.env.example)
# Backend: Supabase Native (Auth, Database, Storage)
# Hosting: Firebase Hosting (Static Frontend Build)
# =========================================================================

# Modo de entorno
VITE_APP_ENV=development
VITE_USE_EMULATOR=false

# Credenciales Públicas de Supabase (Cliente Frontend)
# SEGURIDAD: Emplear ÚNICAMENTE la clave anónima (anon public key).
# NUNCA exponga la clave 'service_role' en el cliente web.
VITE_SUPABASE_URL=https://ejemplo.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key

# Servicio de Correo Electrónico Transaccional (EmailJS)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Proveedores de Tasas Cambiarias y Divisas (Multi-Adapter Forex)
# 1. DolarApi.com (Primario: 100% Gratuito, sin clave, CORS abierto)
VITE_DOLAR_API_BASE=https://ve.dolarapi.com/v1

# 2. DolarVzla (Secundario / Historial e Intervenciones)
VITE_DOLAR_VZLA_KEY=
VITE_DOLAR_VZLA_CDN=https://rates.dolarvzla.com
VITE_DOLAR_VZLA_API=https://api.dolarvzla.com

# 3. MontosVE (Opcional)
VITE_MONTOS_VE_KEY=
VITE_MONTOS_VE_API=https://montosve.com/v1
